# Server only. Never prefix provider or service-role keys with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=
# Optional image-search fallback:
BRAVE_API_KEY=

# Existing project configuration:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SITE_PASSWORD=
# Recommended dedicated signing secret. When absent, a domain-separated key is
# derived from SUPABASE_SERVICE_ROLE_KEY. Changing either signing source logs users out.
SESSION_SECRET=

# Existing explicit Beehiiv export configuration:
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
BEEHIIV_POST_TEMPLATE_ID=
